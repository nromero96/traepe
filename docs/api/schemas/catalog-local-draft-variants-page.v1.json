{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "title": "Catalog local draft variants page response v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "data",
    "meta"
  ],
  "properties": {
    "data": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "id",
          "attributes"
        ],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "local_draft_variant"
            ]
          },
          "id": {
            "type": "string",
            "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}(?![\\s\\S])"
          },
          "attributes": {
            "type": "object",
            "required": [
              "schema_version",
              "catalog_public_id",
              "product_public_id",
              "name",
              "sku",
              "size",
              "unit",
              "barcode",
              "attributes",
              "status",
              "version"
            ],
            "additionalProperties": false,
            "properties": {
              "schema_version": {
                "type": "integer",
                "enum": [
                  1
                ]
              },
              "catalog_public_id": {
                "type": "string",
                "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}(?![\\s\\S])"
              },
              "product_public_id": {
                "type": "string",
                "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}(?![\\s\\S])"
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 255,
                "pattern": "^[^\\x00-\\x1F\\x7F]*[^ \\x00-\\x1F\\x7F][^\\x00-\\x1F\\x7F]*(?![\\s\\S])"
              },
              "sku": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "^[A-Z0-9][A-Z0-9._-]{0,63}(?![\\s\\S])"
              },
              "size": {
                "type": [
                  "string",
                  "null"
                ],
                "minLength": 1,
                "maxLength": 255,
                "pattern": "^[^\\x00-\\x1F\\x7F]*[^ \\x00-\\x1F\\x7F][^\\x00-\\x1F\\x7F]*(?![\\s\\S])"
              },
              "unit": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "^[^\\x00-\\x1F\\x7F]*[^ \\x00-\\x1F\\x7F][^\\x00-\\x1F\\x7F]*(?![\\s\\S])"
              },
              "barcode": {
                "type": [
                  "string",
                  "null"
                ],
                "minLength": 1,
                "maxLength": 64,
                "pattern": "^[!-~]{1,64}(?![\\s\\S])"
              },
              "attributes": {
                "type": "object",
                "maxProperties": 20,
                "additionalProperties": false,
                "patternProperties": {
                  "^[a-z][a-z0-9_]{0,63}(?![\\s\\S])": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 255,
                    "pattern": "^[^\\x00-\\x1F\\x7F]*[^ \\x00-\\x1F\\x7F][^\\x00-\\x1F\\x7F]*(?![\\s\\S])"
                  }
                }
              },
              "status": {
                "type": "string",
                "enum": [
                  "draft"
                ]
              },
              "version": {
                "type": "integer",
                "enum": [
                  1
                ]
              }
            }
          }
        }
      }
    },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "correlation_id",
        "catalog_version",
        "next_cursor",
        "has_more",
        "filters",
        "product_version"
      ],
      "properties": {
        "correlation_id": {
          "type": "string",
          "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
        },
        "catalog_version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "next_cursor": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^[A-Za-z0-9_-]+(?![\\s\\S])"
        },
        "has_more": {
          "type": "boolean"
        },
        "filters": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "catalog_public_id",
            "limit",
            "product_public_id"
          ],
          "properties": {
            "catalog_public_id": {
              "type": "string",
              "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}(?![\\s\\S])"
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            },
            "product_public_id": {
              "type": "string",
              "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}(?![\\s\\S])"
            }
          }
        },
        "product_version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        }
      }
    }
  }
}
