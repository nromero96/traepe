{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "title": "Catalog local draft current profile attributes v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "merchant_public_id",
    "name",
    "status",
    "version"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "enum": [
        1
      ]
    },
    "merchant_public_id": {
      "type": "string",
      "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}(?![\\s\\S])"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "pattern": "^[^\\x00-\\x1F\\x7F]*[^ \\x00-\\x1F\\x7F][^\\x00-\\x1F\\x7F]*(?![\\s\\S])"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft"
      ]
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    }
  }
}
