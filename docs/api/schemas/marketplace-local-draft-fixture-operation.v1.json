{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "title": "Marketplace local fixture snapshot v1",
  "type": "object",
  "required": [
    "profile_version",
    "country_public_id",
    "market_public_id",
    "zone_public_ids"
  ],
  "additionalProperties": false,
  "properties": {
    "profile_version": {
      "type": "string",
      "enum": [
        "synthetic-origin-a-v1",
        "synthetic-origin-b-v1"
      ]
    },
    "country_public_id": {
      "type": "string",
      "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
    },
    "market_public_id": {
      "type": "string",
      "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
    },
    "zone_public_ids": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
      }
    }
  }
}
