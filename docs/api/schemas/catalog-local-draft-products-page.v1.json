{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "title": "Catalog local draft current products page v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "data",
    "meta"
  ],
  "properties": {
    "data": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "id",
          "attributes"
        ],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "local_draft_product"
            ]
          },
          "id": {
            "type": "string",
            "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}(?![\\s\\S])"
          },
          "attributes": {
            "type": "object",
            "required": [
              "schema_version",
              "catalog_public_id",
              "name",
              "description",
              "brand",
              "status",
              "version"
            ],
            "additionalProperties": false,
            "properties": {
              "catalog_public_id": {
                "type": "string",
                "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}(?![\\s\\S])"
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 255,
                "pattern": "^[^\\x00-\\x1F\\x7F]*[^ \\x00-\\x1F\\x7F][^\\x00-\\x1F\\x7F]*(?![\\s\\S])"
              },
              "description": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 4000,
                "pattern": "^[^\\x00-\\x09\\x0B-\\x1F\\x7F]*(?![\\s\\S])"
              },
              "brand": {
                "type": [
                  "string",
                  "null"
                ],
                "minLength": 1,
                "maxLength": 255,
                "pattern": "^[^\\x00-\\x1F\\x7F]*[^ \\x00-\\x1F\\x7F][^\\x00-\\x1F\\x7F]*(?![\\s\\S])"
              },
              "status": {
                "enum": [
                  "draft"
                ],
                "type": "string"
              },
              "version": {
                "type": "integer",
                "minimum": 1,
                "maximum": 2147483647
              },
              "schema_version": {
                "type": "integer",
                "enum": [
                  1
                ]
              }
            }
          }
        }
      }
    },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "correlation_id",
        "catalog_version",
        "next_cursor",
        "has_more",
        "filters"
      ],
      "properties": {
        "correlation_id": {
          "type": "string",
          "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
        },
        "catalog_version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "next_cursor": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^[A-Za-z0-9_-]+(?![\\s\\S])"
        },
        "has_more": {
          "type": "boolean"
        },
        "filters": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "catalog_public_id",
            "limit"
          ],
          "properties": {
            "catalog_public_id": {
              "type": "string",
              "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}(?![\\s\\S])"
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            }
          }
        }
      }
    }
  }
}
